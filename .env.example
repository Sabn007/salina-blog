# Strapi CMS — API host only. Never use this as NEXT_PUBLIC_SITE_URL.
# Local:        http://localhost:1337
# Production:   https://salina-cms.onrender.com
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: API token for draft preview ONLY (`/blog/{slug}?preview=true`).
# Public list/detail reads do not send this token. A bad/expired token can
# 401 public content if attached globally — leave unset unless you need preview.
# STRAPI_API_TOKEN=your-api-token-here

# On-demand revalidation secret (set the same on Strapi webhook)
# REVALIDATION_SECRET=your-random-secret

# Frontend site URL — canonical, Open Graph, Twitter, JSON-LD, sitemap, RSS.
# Local:        http://localhost:3000
# Production:   https://salina-blog-mu.vercel.app
# Do NOT set this to the CMS host (https://salina-cms.onrender.com).
NEXT_PUBLIC_SITE_NAME=Salina Journal
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DESCRIPTION=A premium lifestyle and travel journal — curated stories, destinations, and inspiration for the modern wanderer.

# Production example (Vercel):
# NEXT_PUBLIC_STRAPI_URL=https://salina-cms.onrender.com
# NEXT_PUBLIC_SITE_URL=https://salina-blog-mu.vercel.app

# Google AdSense (optional)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxx

# EmailJS (contact form)
# Get these from https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_5jufve6
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_ffqmf4l
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=e5hErFzzAkWCfDAeE
